<section class="container-page py-10">
  <div class="mb-6 border-b border-gray-100 pb-4">
    <h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
  </div>

  <!-- 子分类标签 -->
  {% if subCates.size > 0 %}
  <div class="mb-6 flex flex-wrap gap-2">
    <a href="{{ pathname }}" class="rounded-full px-4 py-1.5 text-sm {% if cateId == '' %}bg-brand-600 text-white{% else %}bg-gray-100 text-gray-600 hover:bg-gray-200{% endif %}">全部</a>
    {% for c in subCates %}
    <a href="{{ pathname }}?pid={{ c._id }}" class="rounded-full px-4 py-1.5 text-sm {% if cateId == c._id %}bg-brand-600 text-white{% else %}bg-gray-100 text-gray-600 hover:bg-gray-200{% endif %}">{{ c.title }}</a>
    {% endfor %}
  </div>
  {% endif %}

  <!-- 搜索 -->
  <form method="get" class="mb-6 flex gap-2">
    <input type="text" name="keyword" value="{{ keyword }}" placeholder="搜索{{ title }}…" class="w-full max-w-sm rounded-md border border-gray-200 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none">
    <button class="btn-brand">搜索</button>
  </form>

  <!-- 列表 -->
  {% if articles.size > 0 %}
  <div class="grid gap-5">
    {% for a in articles %}
    <article class="card flex gap-4 p-4 transition hover:shadow-md">
      {% if a.img_url %}<a href="/content/{{ a._id }}" class="shrink-0"><img src="{{ a.img_url }}" alt="{{ a.title }}" class="h-28 w-40 rounded-lg object-cover"></a>{% endif %}
      <div class="min-w-0 flex-1">
        <div class="mb-1 flex items-center gap-2 text-xs text-gray-400">
          {% if a.cate_name %}<span class="rounded bg-brand-50 px-2 py-0.5 text-brand-600">{{ a.cate_name }}</span>{% endif %}
          <span>{{ a.add_time | date }}</span>
        </div>
        <h3 class="truncate text-lg font-semibold text-gray-900">
          <a href="/content/{{ a._id }}" class="hover:text-brand-600">{{ a.title }}</a>
        </h3>
        {% if a.description %}<p class="mt-1 line-clamp-2 text-sm text-gray-500">{{ a.description }}</p>{% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p class="py-16 text-center text-gray-400">暂无内容</p>
  {% endif %}

  <!-- 分页 -->
  {% if pageInfo.totalPages > 1 %}
  <nav class="mt-8 flex items-center justify-center gap-1">
    {% if pageInfo.hasPrev %}<a href="{{ pathname }}{% if cateId %}?pid={{ cateId }}&{% else %}?{% endif %}page={{ pageInfo.page | minus: 1 }}{% if keyword %}&keyword={{ keyword }}{% endif %}" class="rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50">上一页</a>{% endif %}
    {% for p in (1..pageInfo.totalPages) %}
    <a href="{{ pathname }}{% if cateId %}?pid={{ cateId }}&{% else %}?{% endif %}page={{ p }}{% if keyword %}&keyword={{ keyword }}{% endif %}" class="rounded-md border px-3 py-1.5 text-sm {% if p == pageInfo.page %}border-brand-600 bg-brand-600 text-white{% else %}border-gray-200 hover:bg-gray-50{% endif %}">{{ p }}</a>
    {% endfor %}
    {% if pageInfo.hasNext %}<a href="{{ pathname }}{% if cateId %}?pid={{ cateId }}&{% else %}?{% endif %}page={{ pageInfo.page | plus: 1 }}{% if keyword %}&keyword={{ keyword }}{% endif %}" class="rounded-md border border-gray-200 px-3 py-1.5 text-sm hover:bg-gray-50">下一页</a>{% endif %}
  </nav>
  {% endif %}
</section>
