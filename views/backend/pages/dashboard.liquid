{% layout 'backend/layout', title: '仪表盘' %}
{% block content %}
  {% include 'backend/partials/page-title', title: '仪表盘', subtitle: '首页' %}

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="kt-card">
      <div class="kt-card-content flex items-center justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-default-500">文章总数</p>
          <h3 class="mt-1 text-2xl font-semibold text-default-900">{{ stats.article }}</h3>
        </div>
        <span class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary">
          <i data-lucide="file-text" class="size-5"></i>
        </span>
      </div>
    </div>
    <div class="kt-card">
      <div class="kt-card-content flex items-center justify-between">
        <div>
          <p class="text-xs uppercase tracking-wide text-default-500">分类总数</p>
          <h3 class="mt-1 text-2xl font-semibold text-default-900">{{ stats.cate }}</h3>
        </div>
        <span class="flex size-12 items-center justify-center rounded-full bg-teal-500/10 text-teal-500">
          <i data-lucide="folder" class="size-5"></i>
        </span>
      </div>
    </div>
  </div>

  <div class="mt-6 kt-card">
    <div class="kt-card-header"><h4 class="kt-card-title">快速入口</h4></div>
    <div class="kt-card-content flex flex-wrap gap-3">
      <a href="/backend/article" class="kt-btn kt-btn-primary">文章管理</a>
      <a href="/backend/articlecate" class="kt-btn kt-btn-outline">分类管理</a>
      <a href="/backend/setting" class="kt-btn kt-btn-outline">站点设置</a>
      <a href="/backend/stats" class="kt-btn kt-btn-outline">统计报表</a>
    </div>
  </div>
{% endblock %}
