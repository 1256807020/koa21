<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>登录 · {{ site.title | default: "管理后台" }}</title>
  <link rel="stylesheet" href="/backend/css/app.css">
</head>
<body class="flex min-h-screen items-center justify-center bg-gray-100">
  <div class="w-full max-w-sm">
    <div class="card p-8">
      <h1 class="mb-6 text-center text-xl font-bold text-gray-900">{{ site.title | default: "管理后台" }} · 登录</h1>
      {% if error %}<div class="mb-4 rounded-md bg-red-50 px-4 py-2 text-sm text-red-600">{{ error }}</div>{% endif %}
      <form method="post" action="/backend/login/doLogin" class="space-y-4">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div>
          <label class="mb-1 block text-sm text-gray-600">用户名</label>
          <input type="text" name="username" required autocomplete="username" class="w-full rounded-md border border-gray-200 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none">
        </div>
        <div>
          <label class="mb-1 block text-sm text-gray-600">密码</label>
          <input type="password" name="password" required autocomplete="current-password" class="w-full rounded-md border border-gray-200 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none">
        </div>
        <button class="btn-brand w-full">登录</button>
      </form>
      <p class="mt-4 text-center text-xs text-gray-400"><a href="/" class="hover:text-brand-600">返回首页</a></p>
    </div>
  </div>
</body>
</html>
