<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>出错了</title>
  <link rel="stylesheet" href="/backend/css/app.css">
</head>
<body class="flex min-h-screen items-center justify-center bg-gray-100">
  <div class="card max-w-md p-8 text-center">
    <h1 class="text-lg font-semibold text-gray-900">操作未完成</h1>
    <p class="mt-3 text-sm text-gray-500">{{ message | default: "发生错误" }}</p>
    <a href="{{ redirect | default: '/' }}" class="btn-brand mt-6 inline-block">返回</a>
  </div>
</body>
</html>
