<footer class="mt-16 border-t border-gray-100 bg-white">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <h3 class="text-base font-semibold text-gray-900">{{ site.title | default: "网站" }}</h3>
      {% if site.description %}<p class="mt-3 text-sm leading-relaxed text-gray-500">{{ site.description }}</p>{% endif %}
    </div>
    <div>
      <h4 class="text-sm font-semibold text-gray-900">联系方式</h4>
      <ul class="mt-3 space-y-1 text-sm text-gray-500">
        {% if site.tel %}<li>电话：{{ site.tel }}</li>{% endif %}
        {% if site.qq %}<li>QQ：{{ site.qq }}</li>{% endif %}
        {% if site.address %}<li>地址：{{ site.address }}</li>{% endif %}
      </ul>
    </div>
    <div>
      <h4 class="text-sm font-semibold text-gray-900">快速链接</h4>
      <ul class="mt-3 space-y-1 text-sm text-gray-500">
        <li><a href="/news" class="hover:text-brand-600">新闻动态</a></li>
        <li><a href="/case" class="hover:text-brand-600">成功案例</a></li>
        <li><a href="/service" class="hover:text-brand-600">服务</a></li>
        <li><a href="/about" class="hover:text-brand-600">关于我们</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-sm font-semibold text-gray-900">友情链接</h4>
      <ul class="mt-3 space-y-1 text-sm text-gray-500">
        {% if links.size > 0 %}
          {% for l in links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener" class="hover:text-brand-600">{{ l.title }}</a></li>{% endfor %}
        {% else %}
          <li class="text-gray-400">暂无</li>
        {% endif %}
      </ul>
    </div>
  </div>
  <div class="border-t border-gray-100 py-4 text-center text-xs text-gray-400">
    © {{ year }} {{ site.title | default: "网站" }}
    {% if site.icp %}· <a href="https://beian.miit.gov.cn" target="_blank" rel="noopener" class="hover:text-brand-600">{{ site.icp }}</a>{% endif %}
  </div>
</footer>
