{% layout '../layout', title: article.title %}
{% block content %}
<article class="container-page py-10">
  <nav class="mb-4 text-sm text-gray-400">
    {% for b in breadcrumb %}<a href="{{ b.url | default: '#' }}" class="hover:text-brand-600">{{ b.title }}</a>{% if not forloop.last %} / {% endif %}{% endfor %}
  </nav>
  <h1 class="text-3xl font-bold text-gray-900">{{ article.title }}</h1>
  <div class="mt-3 flex items-center gap-3 text-sm text-gray-400">
    {% if article.author %}<span>作者：{{ article.author }}</span>{% endif %}
    <span>{{ article.add_time | date }}</span>
    {% if article.cate_name %}<span class="rounded bg-brand-50 px-2 py-0.5 text-brand-600">{{ article.cate_name }}</span>{% endif %}
  </div>
  {% if article.img_url %}<img src="{{ article.img_url }}" alt="{{ article.title }}" class="mt-6 w-full rounded-xl object-cover">{% endif %}
  <div class="prose mt-6 max-w-none">
    {{ article.content | raw }}
  </div>

  <div class="mt-10 flex items-center justify-between border-t border-gray-100 pt-6 text-sm">
    <div>
      {% if prev %}<a href="/content/{{ prev._id }}" class="text-gray-600 hover:text-brand-600">‹ {{ prev.title }}</a>
      {% else %}<span class="text-gray-300">已是第一篇</span>{% endif %}
    </div>
    <div>
      {% if next %}<a href="/content/{{ next._id }}" class="text-gray-600 hover:text-brand-600">{{ next.title }} ›</a>
      {% else %}<span class="text-gray-300">已是最后一篇</span>{% endif %}
    </div>
  </div>
</article>
{% endblock %}
