{
  "name": "koa21",
  "version": "2.0.0",
  "private": true,
  "description": "Koa CMS（原 koa2 教程项目）· 数据层已迁移至 PostgreSQL 18",
  "main": "app.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon app.js",
    "start": "cross-env NODE_ENV=production node app.js",
    "start:test": "cross-env NODE_ENV=test node app.js",
    "db:init": "node db/init.js",
    "db:reset": "node db/init.js --reset",
    "lint": "eslint ."
  },
  "keywords": [
    "koa",
    "cms",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koa/cors": "5.0.0",
    "@koa/multer": "4.0.0",
    "@koa/router": "15.7.0",
    "art-template": "4.13.4",
    "bcryptjs": "3.0.3",
    "dayjs": "1.11.23",
    "dotenv": "18.0.0",
    "koa": "3.2.1",
    "koa-art-template": "1.1.1",
    "koa-bodyparser": "4.4.1",
    "koa-session": "7.0.2",
    "koa-static": "5.0.0",
    "log4js": "6.9.1",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "svg-captcha": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "nodemon": "3.1.7"
  }
}
