{
  "name": "koa21",
  "version": "2.0.0",
  "private": true,
  "description": "Koa CMS（原 koa2 教程项目）· 数据层已迁移至 PostgreSQL 18",
  "main": "app.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node app.js",
    "start": "cross-env NODE_ENV=production node app.js",
    "start:test": "cross-env NODE_ENV=test node app.js",
    "db:init": "node db/init.js",
    "db:reset": "node db/init.js --reset",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "audit:archive": "node scripts/audit-archive.js",
    "build:css": "tailwindcss -i src/styles/backend.css -o public/backend/css/app.css --minify && tailwindcss -i src/styles/frontend.css -o public/themes/default/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/backend.css -o public/backend/css/app.css --watch",
    "build:frontend-css": "tailwindcss -i src/styles/frontend.css -o public/themes/default/css/app.css --minify",
    "build:editor": "esbuild src/backend/editor.js --bundle --minify --format=iife --outfile=public/backend/editor.js",
    "build": "pnpm build:css && pnpm build:editor"
  },
  "keywords": [
    "koa",
    "cms",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koa/cors": "5.0.0",
    "@koa/multer": "4.0.0",
    "@koa/router": "15.7.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "bcryptjs": "3.0.3",
    "dayjs": "1.11.23",
    "dotenv": "18.0.0",
    "koa": "3.2.1",
    "koa-bodyparser": "4.4.1",
    "koa-session": "7.0.2",
    "koa-static": "5.0.0",
    "liquidjs": "10.29.0",
    "log4js": "6.9.1",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "sanitize-html": "2.17.7",
    "svg-captcha": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "lucide": "1.47.0",
    "tailwindcss": "^4.3.3"
  }
}
